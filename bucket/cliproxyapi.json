{
    "version": "7.2.83-pro",
    "description": "Wrap Gemini CLI, Antigravity, ChatGPT Codex, Claude Code, Grok Build as an OpenAI/Gemini/Claude/Codex compatible API service.",
    "homepage": "https://github.com/ssfun/CLIProxyAPI-Pro",
    "license": "MIT",
    "notes": [
        "cliproxyapi 默认使用 \"$persist_dir\\config.yaml\" 作为配置文件。",
        "如需使用其他配置文件，请运行：",
        "\"$dir\\cli-proxy-api.exe\" --config <新配置文件路径>"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ssfun/CLIProxyAPI-Pro/releases/download/v7.2.83-pro/CLIProxyAPI_7.2.83-pro_windows_amd64.zip",
            "hash": "f2e7a91944c38208f370900fc11710af840ecb7de3af5908b3033eaa2585ddfc"
        },
        "arm64": {
            "url": "https://github.com/ssfun/CLIProxyAPI-Pro/releases/download/v7.2.83-pro/CLIProxyAPI_7.2.83-pro_windows_aarch64.zip",
            "hash": "1a411299c4d6c93ec73c01f2eaf4315f649148a854a009cfda536db0a195781d"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -Path \"$persist_dir\\config.yaml\")) {",
        "    Copy-Item -Path \"$dir\\config.example.yaml\" -Destination \"$dir\\config.yaml\"",
        "}"
    ],
    "bin": [
        [
            "cli-proxy-api.exe",
            "cliproxyapi",
            "--config \"$persist_dir\\config.yaml\""
        ]
    ],
    "persist": "config.yaml",
    "checkver": {
        "github": "https://github.com/ssfun/CLIProxyAPI-Pro"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ssfun/CLIProxyAPI-Pro/releases/download/v$version/CLIProxyAPI_$version_windows_amd64.zip"
            },
            "arm64": {
                "url": "https://github.com/ssfun/CLIProxyAPI-Pro/releases/download/v$version/CLIProxyAPI_$version_windows_aarch64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/checksums.txt"
        }
    }
}
